# ─── DEMO MODE ────────────────────────────────────────────────────────────────
# Portfolio/demo mode is always on in this public repo. Default: true.
DEMO_MODE=true

# ─── Node.js Backend ──────────────────────────────────────────────────────────
PORT=3000

# Supabase (project → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs (Products → your subscription plans)
STRIPE_PRICE_AUTO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MANUAL_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_AUTO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MANUAL_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx

# MetaAPI (app.metaapi.cloud → API access)
METAAPI_TOKEN=your-metaapi-token

# CopyFactory (app.metaapi.cloud → CopyFactory)
COPYFACTORY_STRATEGY_ID=your-copyfactory-strategy-id

# Telegram Bot (BotFather → create bot → copy token)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# Webhook security (random secret shared between backend and Python agents)
WEBHOOK_SECRET=your-random-webhook-secret-min-32-chars

# CORS (comma-separated list of allowed frontend origins)
# Unset + DEMO_MODE=true  -> localhost origins are allowed, so the demo runs
#                            with no .env at all.
# Unset + DEMO_MODE=false -> no cross-origin request is allowed. Set this.
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Number of reverse-proxy hops in front of the app. Controls req.ip, which the
# per-IP rate limiter depends on.
#   1       correct on Railway (and most PaaS) — one proxy in front
#   false   correct when nothing proxies the app
# Setting this higher than reality lets clients spoof X-Forwarded-For and slip
# past the rate limiter; setting it lower buckets every visitor together.
# Default when unset: false in DEMO_MODE, otherwise 1.
TRUST_PROXY=1

# Onboarding token signing secret (for resume tokens)
ONBOARDING_TOKEN_SECRET=your-random-hmac-secret-min-32-chars

# ─── Python Automation ────────────────────────────────────────────────────────

# Claude / Anthropic API (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# TwelveData (twelvedata.com → API → your key)
TWELVE_DATA_API_KEY=your-twelvedata-api-key

# Railway backend URL (used by Python agents to call webhooks)
RAILWAY_SERVER_URL=https://your-railway-backend.up.railway.app

# Telegram (same bot token as backend, separate chat for agent notifications)
TELEGRAM_AGENT_CHAT_ID=your-agent-chat-id

# How many days of candle history to fetch
LOOKBACK_DAYS=60

# Broker UTC offset (e.g. 3 for GMT+3 EET)
BROKER_UTC_OFFSET=3

# ─── HHHL Local Agent (agent_hhhl.py — runs on local Windows machine with MT5) ──
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Server
HHHL_LOT=0.01
